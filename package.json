{
  "name": "outlook-mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol server for Microsoft Outlook via Graph API",
  "main": "dist/index.js",
  "bin": {
    "outlook-mcp": "./dist/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "INSTRUCTIONS.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write 'src/**/*.ts'",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "outlook",
    "microsoft-graph",
    "email",
    "office365"
  ],
  "author": "Claude Code",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/outlook-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/outlook-mcp/issues"
  },
  "homepage": "https://github.com/your-username/outlook-mcp#readme",
  "type": "module",
  "dependencies": {
    "@azure/identity": "^4.12.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@microsoft/microsoft-graph-types": "^2.40.0",
    "@modelcontextprotocol/sdk": "^1.18.1",
    "dotenv": "^17.2.2",
    "isomorphic-fetch": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.5.2",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.1.3",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
