{
  "name": "@gchallen/outlook-mcp",
  "version": "2026.10.0",
  "description": "Model Context Protocol server for Microsoft Outlook, Calendar, Contacts, and Teams via Microsoft Graph",
  "main": "dist/index.js",
  "bin": {
    "outlook-mcp": "./dist/cli.js"
  },
  "files": [
    "dist/**/*",
    "docs/**/*",
    "README.md",
    "SETUP.md",
    "INSTRUCTIONS.md",
    "manifest.json",
    "package.json"
  ],
  "scripts": {
    "build": "tsc",
    "login": "node dist/cli.js login",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "setup": "node dist/cli.js setup",
    "bundle": "sh scripts/bundle.sh"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "outlook",
    "microsoft-graph",
    "email",
    "office365",
    "teams",
    "education"
  ],
  "author": "Geoffrey Challen",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gchallen/outlook-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/gchallen/outlook-mcp/issues"
  },
  "homepage": "https://github.com/gchallen/outlook-mcp#readme",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "dependencies": {
    "@azure/msal-node": "^3.7.4",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@microsoft/microsoft-graph-types": "^2.40.0",
    "@modelcontextprotocol/sdk": "^1.18.1",
    "dotenv": "^17.2.2",
    "isomorphic-fetch": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.5.2",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.1.3",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
