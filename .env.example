# Optional. Settings normally live in ~/.outlook-mcp/config.json, written by
# `npx -y @gchallen/outlook-mcp setup`. Values here (or in the environment)
# override that file.

# Azure App Registration (device-code / public client flow)
AZURE_CLIENT_ID=your_client_id_here
# Optional when OUTLOOK_EMAIL is set: the tenant is looked up from the domain.
AZURE_TENANT_ID=your_tenant_id_here
# OUTLOOK_EMAIL=you@university.edu

# Optional: skip Teams permissions at sign-in.
# OUTLOOK_TEAMS=false

# Optional: override the delegated Graph scopes (comma-separated).
# GRAPH_SCOPES=Mail.ReadWrite,Mail.Send,Calendars.ReadWrite,Contacts.ReadWrite,People.Read,User.Read
# EXTRA_GRAPH_SCOPES=ChannelMessage.Read.All

# Optional: where the sign-in token cache lives.
# OUTLOOK_TOKEN_CACHE=/absolute/path/to/token-cache.json
