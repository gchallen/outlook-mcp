# Azure App Registration (device-code / public client flow)
AZURE_CLIENT_ID=your_client_id_here
AZURE_TENANT_ID=your_tenant_id_here

# Optional: override the delegated Graph scopes (comma-separated).
# Defaults to: Mail.ReadWrite,Mail.Send,Calendars.ReadWrite,Contacts.ReadWrite,User.Read
# GRAPH_SCOPES=Mail.ReadWrite,Mail.Send,Calendars.ReadWrite,Contacts.ReadWrite,User.Read
